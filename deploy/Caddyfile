# Front door for the demo VM: HTTPS with an automatic Let's Encrypt certificate.
# TQ_SITE is the public hostname (e.g. 199-247-22-132.sslip.io, set in deploy/.env).
# Unset, it defaults to :80 (plain HTTP), as before.
{$TQ_SITE} {
	encode gzip
	reverse_proxy app:8000 {
		# keep the live activity stream unbuffered
		flush_interval -1
	}
}
